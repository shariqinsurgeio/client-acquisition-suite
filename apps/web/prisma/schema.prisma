generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlatformSelector {
  id        String @id @default(uuid())
  platform  String
  selectors String
}

model Job {
  id          String   @id @default(uuid())
  platform    String
  title       String
  description String
  url         String   @unique
  status      String
  fitScore    Int?
  createdAt   DateTime @default(now())
}
