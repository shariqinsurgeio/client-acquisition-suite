{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx server.ts",
    "dev:legacy": "node server.js",
    "build": "next build && npx tsc server.ts --outDir . --esModuleInterop --skipLibCheck --module commonjs --target ES2020",
    "build:server": "npx tsc server.ts --outDir . --esModuleInterop --skipLibCheck --module commonjs --target ES2020",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@clerk/backend": "^2.29.2",
    "@clerk/nextjs": "^6.36.7",
    "@prisma/client": "^6.19.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "prisma": "^6.19.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
